# WRMSR—Write to Model Specific Register -- override
# 'MSR[ECX] := EDX:EAX;' for the MSRs v1 has; others raise #GP(0).
@operation
tmp := SHL(ZeroExtend(EDX), 32) OR ZeroExtend(EAX);
IF ECX = C0000080H THEN WriteSpecial(EFER, tmp);
ELSE IF ECX = C0000100H THEN WriteSpecial(FS_BASE, tmp);
ELSE IF ECX = C0000101H THEN WriteSpecial(GS_BASE, tmp);
ELSE IF ECX = C0000102H THEN WriteSpecial(KERNEL_GS_BASE, tmp);
ELSE IF ECX = C0000081H THEN WriteSpecial(STAR, tmp);
ELSE IF ECX = C0000082H THEN WriteSpecial(LSTAR, tmp);
ELSE IF ECX = C0000083H THEN WriteSpecial(CSTAR, tmp);
ELSE IF ECX = C0000084H THEN WriteSpecial(FMASK, tmp);
ELSE IF ECX = C0000103H THEN WriteSpecial(TSC_AUX, tmp);
ELSE IF ECX = 10H THEN WriteSpecial(TSC, tmp);
ELSE IF ECX = 1BH THEN
    (* IA32_APIC_BASE (Intel SDM Vol. 3A 12.4.4, 12.12.5 "x2APIC State
       Transitions"): reserved bits 7:0, 9 and 63:52 (MAXPHYADDR 52) #GP; BSP
       is read-only; EN:EXTD = 01b is invalid, x2APIC to xAPIC and disabled to
       x2APIC are not allowed transitions (#GP) *)
    cur := APIC_BASE;
    IF (tmp AND FFF00000000002FFH) != 0 THEN #GP(0); FI;
    new := (tmp AND FFFFFFFFFFFFFEFFH) OR (cur AND 100H);
    was := SHR(cur, 10) AND 3;
    now := SHR(new, 10) AND 3;
    IF now = 1 THEN #GP(0); FI;
    IF was = 3 AND now = 2 THEN #GP(0); FI;
    IF was = 0 AND now = 3 THEN #GP(0); FI;
    WriteSpecial(APIC_BASE, new);
ELSE IF ECX = 277H THEN WriteSpecial(PAT, tmp);
ELSE IF ECX = 1A0H THEN WriteSpecial(MISC_ENABLE, tmp);
ELSE IF (ECX >= 800H AND ECX <= 8FFH) OR ECX = 6E0H THEN
    (* x2APIC registers, IA32_TSC_DEADLINE: #GP if not legal *)
    ApicWrite(ECX, tmp);
ELSE #GP(0);
FI;
