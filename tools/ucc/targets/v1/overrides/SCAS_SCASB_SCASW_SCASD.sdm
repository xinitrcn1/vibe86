# SCAS -- override
# As MOVS: the 64-bit-mode half of the manual's Operation, with the
# REPE/REPNE loop of the REP page composed in for the F3 (repeat while
# equal) and F2 (repeat while not equal) forms. The comparison sets the
# flags as CMP does (Flags Affected).
@operation
IF DF = 0
    THEN delta := OperandBytes;
    ELSE delta := 0 - OperandBytes;
FI;
IF RepPrefix
    THEN
        WHILE rCX != 0
        DO
        b := Memory[ES:rDI];
        temp := accumulator - b;
        ModifyStatusFlags;
        rDI := rDI + delta;
            rCX := rCX - 1;
            Commit;
            IF RepNE
                THEN IF ZF = 1 THEN BREAK; FI;
                ELSE IF ZF = 0 THEN BREAK; FI;
            FI;
        OD;
    ELSE
        b := Memory[ES:rDI];
        temp := accumulator - b;
        ModifyStatusFlags;
        rDI := rDI + delta;
FI;
