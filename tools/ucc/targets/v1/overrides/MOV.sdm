# MOV—Move -- override
# 'DEST := SRC;' for the general-purpose rows; for MOV Sreg, r/m the
# segment-register load the rest of the Operation describes in prose,
# through LoadSegment (lib.sdm). "Loading the SS register with a MOV
# instruction suppresses or inhibits some debug exceptions and inhibits
# interrupts on the following instruction boundary" (Description).
@operation
IF SregDest
    THEN
        IF Sreg = 1 THEN #UD; FI;
        LoadSegment(Sreg, SRC);
        IF Sreg = 2 THEN InhibitInterrupts; FI;
    ELSE
        DEST := SRC;
FI;
