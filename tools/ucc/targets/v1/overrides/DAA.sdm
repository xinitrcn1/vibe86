# DAA—Decimal Adjust AL After Addition -- override
# The manual's Operation, with its prose "Carry from AL := AL + 6" computed
# at 9 bits; SF, ZF and PF of the result (Flags Affected), OF undefined.
@operation
old_AL := AL;
old_CF := CF;
CF := 0;
IF ((AL AND 0FH) > 9) OR (AF = 1)
    THEN
        tmp := ZeroExtend(AL) + 6;
        AL := tmp;
        IF old_CF = 1 OR tmp > FFH THEN CF := 1; FI;
        AF := 1;
    ELSE AF := 0;
FI;
IF (old_AL > 99H) OR (old_CF = 1)
    THEN
        AL := AL + 60H;
        CF := 1;
    ELSE CF := 0;
FI;
SF := MSB(AL);
IF AL = 0 THEN ZF := 1; ELSE ZF := 0; FI;
PF := BitwiseXNOR(AL);
