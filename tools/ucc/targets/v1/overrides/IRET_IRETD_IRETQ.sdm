# IRET/IRETD/IRETQ -- override
# The manual's Operation for the cases v1 delivers interrupts in:
# REAL-ADDRESS-MODE (pop IP, CS, FLAGS), and protected / IA-32e mode
# returns to a code segment at the same or an outer privilege level
# (RETURN-TO-SAME-PRIVILEGE-LEVEL, RETURN-TO-OUTER-PRIVILEGE-LEVEL; IA-32e
# mode always pops SS:RSP). RFLAGS is loaded with the mask CPL allows (IOPL
# and IF only at CPL 0 / CPL <= IOPL). Task returns (NT = 1) and returns to
# virtual-8086 mode (RETURN-TO-VIRTUAL-8086-MODE: VM set in the popped
# EFLAGS at CPL 0) and IRET in virtual-8086 mode (IOPL 3) are in;
# IRET with NT = 1 outside IA-32e mode
# returns to the previous task (TaskSwitch, lib.sdm).
@operation
IF CR0.PE = 0
    THEN
        tempRIP := Pop();
        tempCS := Pop();
        tempFLAGS := Pop();
        LoadCodeSegment(tempCS, 0, 1);
        IF OperandSize = 16
            THEN StoreFlags(tempFLAGS, 7FD5H);
            ELSE StoreFlags(tempFLAGS, 257FD5H);
        FI;
        RIP := tempRIP;
    ELSE IF RFLAGS.VM = 1
    THEN
        (* IRET in virtual-8086 mode: IOPL-sensitive; at IOPL 3 as in real
           mode, IOPL itself unchanged *)
        IF IOPL != 3 THEN #GP(0); FI;
        tempRIP := Pop();
        tempCS := Pop();
        tempFLAGS := Pop();
        SetSegmentReal(1, tempCS);
        IF OperandSize = 16
            THEN StoreFlags(tempFLAGS, 4DD5H);
            ELSE StoreFlags(tempFLAGS, 254DD5H);
        FI;
        RIP := tempRIP AND FFFFH;
    ELSE IF RFLAGS.NT = 1 AND IA32_EFER.LMA = 0
    THEN
        (* TASK-RETURN: back to the task in this TSS's link field *)
        TaskSwitch(Linear16[TR_BASE], 2, RIP);
    ELSE
        tempRIP := Pop();
        tempCS := Pop();
        tempFLAGS := Pop();
        rpl := tempCS AND 3;
        oldcpl := CPL;
        IF rpl < oldcpl THEN #GP(tempCS AND FFFCH); FI;
        IF (SHR(tempFLAGS, 17) AND 1) = 1 AND oldcpl = 0 AND OperandSize = 32 AND IA32_EFER.LMA = 0
            THEN
                (* RETURN-TO-VIRTUAL-8086-MODE *)
                tempESP := Pop();
                tempSS := Pop();
                tempES := Pop();
                tempDS := Pop();
                tempFS := Pop();
                tempGS := Pop();
                StoreFlags(tempFLAGS, 3F7FD5H);
                WriteSpecial(CPL, 3);
                SetSegmentReal(1, tempCS);
                SetSegmentReal(2, tempSS);
                SetSegmentReal(0, tempES);
                SetSegmentReal(3, tempDS);
                SetSegmentReal(4, tempFS);
                SetSegmentReal(5, tempGS);
                ESP := tempESP;
                RIP := tempRIP AND FFFFH;
                Done;
        FI;
        IF Mode64 = 1 OR rpl > oldcpl
            THEN
                tempRSP := Pop();
                tempSS := Pop();
        FI;
        LoadCodeSegment(tempCS, rpl, 1);
        mask := 254DD5H;
        IF oldcpl = 0 THEN mask := 257FD5H; FI;
        IF oldcpl != 0 AND oldcpl <= IOPL THEN mask := 254FD5H; FI;
        StoreFlags(tempFLAGS, mask);
        IF Mode64 = 1 OR rpl > oldcpl
            THEN
                IF (tempSS AND FFFCH) = 0
                    THEN WriteSpecial(SS_SEL, tempSS);
                    ELSE LoadSegment(2, tempSS);
                FI;
                RSP := tempRSP;
                IF rpl > oldcpl THEN NullUnusableSegments(rpl); FI;
        FI;
        RIP := tempRIP;
FI;
