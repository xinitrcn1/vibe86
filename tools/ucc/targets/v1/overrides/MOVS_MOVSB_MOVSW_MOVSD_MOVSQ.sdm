# MOVS -- override
# The manual's Operation (DEST := SRC with (R|E)SI/(R|E)DI stepped by the element size) labels its
# 64-bit and non-64-bit halves with prose ('64-bit Mode:') and nests an
# 'IF DF = 0' without THEN, which doesn't parse. This is the 64-bit-mode
# half, with the REP prefix's loop from the REP/REPE/REPZ/REPNE/REPNZ page
# ("WHILE CountReg != 0 DO ... CountReg := CountReg - 1; OD") composed in
# for the forms with an F3/F2 prefix. Each iteration commits, as the
# manual's REP description allows an interrupt between iterations.
@operation
IF DF = 0
    THEN delta := OperandBytes;
    ELSE delta := 0 - OperandBytes;
FI;
IF RepPrefix
    THEN
        WHILE rCX != 0
        DO
        tmp := Memory[DS:rSI];
        Memory[ES:rDI] := tmp;
        rSI := rSI + delta;
        rDI := rDI + delta;
            rCX := rCX - 1;
            Commit;
        OD;
    ELSE
        tmp := Memory[DS:rSI];
        Memory[ES:rDI] := tmp;
        rSI := rSI + delta;
        rDI := rDI + delta;
FI;
@flags
None.
