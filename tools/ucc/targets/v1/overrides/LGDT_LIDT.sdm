# LGDT/LIDT—Load Global/Interrupt Descriptor Table Register -- override
# The manual's Operation: a 16-bit limit, then a 24-bit base (operand size
# 16), a 32-bit base (32) or a 64-bit base (64-bit mode), from a memory
# operand of 6 or 10 bytes. #GP(0) at CPL > 0.
@operation
IF CPL > 0 THEN #GP(0); FI;
limit := Memory16[EffectiveAddress(SRC)];
IF Mode64 = 1
    THEN base := Memory64[EffectiveAddress(SRC) + 2];
    ELSE
        base := Memory32[EffectiveAddress(SRC) + 2];
        IF OperandSize = 16 THEN base := base AND FFFFFFH; FI;
FI;
IF instruction is LIDT
    THEN
        WriteSpecial(IDTR_LIMIT, limit);
        WriteSpecial(IDTR_BASE, base);
    ELSE
        WriteSpecial(GDTR_LIMIT, limit);
        WriteSpecial(GDTR_BASE, base);
FI;
