# POP—Pop a Value From the Stack -- override
# The manual's Operation doesn't parse ('ELSE StackAddrSize = 16 THEN' lacks
# its IF). This is Pop at the stack-address size (lib.sdm), and for POP Sreg
# the segment load MOV describes; POP SS inhibits interrupts until the next
# instruction completes (Description).
@operation
IF SegmentOperand
    THEN
        tmp := Pop();
        LoadSegment(Sreg, tmp);
        IF Sreg = 2 THEN InhibitInterrupts; FI;
    ELSE
        DEST := Pop();
FI;
