# CALL—Call Procedure -- override
# Near calls as the manual's Operation (no shadow stack: CET is not in v1).
# Far calls follow its FAR CALL branches: real-address/virtual-8086 mode;
# protected/IA-32e mode to a code segment (CONFORMING/NONCONFORMING-CODE-
# SEGMENT), through a call gate (CALL-GATE, with MORE-PRIVILEGE stack
# switches: CallGate in lib.sdm), or to a task (TASK-GATE, TASK-STATE-
# SEGMENT: TaskSwitch). The return address is pushed at the operand size.
@operation
IF FarJump
    THEN
        IF FarPtrImm
            THEN
                off := DEST;
                sel := FarSelector;
            ELSE
                off := Memory[DEST];
                sel := Memory16[EffectiveAddress(DEST) + OperandSize / 8];
        FI;
        IF OperandSize = 16 THEN off := off AND FFFFH; FI;
        IF OperandSize = 32 THEN off := off AND FFFFFFFFH; FI;
        IF CR0.PE = 0 OR RFLAGS.VM = 1
            THEN
                Push(CS);
                Push(RIP);
                LoadCodeSegment(sel, CPL, 0);
                RIP := off;
            ELSE
                d := ReadDescriptor(sel);
                ty := SHR(d, 40) AND 1FH;
                IF (ty AND 18H) = 18H
                    THEN
                        oldcs := CS;
                        LoadCodeSegment(sel, CPL, 0);
                        Push(oldcs);
                        Push(RIP);
                        RIP := off;
                    ELSE IF ty = 0CH OR ty = 04H
                    THEN
                        CallGate(sel, d, RIP, 1);
                    ELSE IF ty = 05H
                    THEN
                        IF (SHR(d, 45) AND 3) < CPL OR (SHR(d, 45) AND 3) < (sel AND 3) THEN #GP(sel AND FFFCH); FI;
                        IF (SHR(d, 47) AND 1) = 0 THEN #NP(sel AND FFFCH); FI;
                        TaskSwitch(SHR(d, 16) AND FFFFH, 1, RIP);
                    ELSE IF ty = 09H
                    THEN
                        IF (SHR(d, 45) AND 3) < CPL OR (SHR(d, 45) AND 3) < (sel AND 3) THEN #GP(sel AND FFFCH); FI;
                        TaskSwitch(sel, 1, RIP);
                    ELSE
                        #GP(sel AND FFFCH);
                FI;
        FI;
    ELSE
        IF near relative call
            THEN tempRIP := RIP + SignExtend(DEST);
            ELSE tempRIP := DEST;
        FI;
        IF OperandSize = 16 THEN tempRIP := tempRIP AND FFFFH; FI;
        IF OperandSize = 32 THEN tempRIP := tempRIP AND FFFFFFFFH; FI;
        Push(RIP);
        RIP := tempRIP;
FI;
