# CALL—Call Procedure -- override
# The near-call branches of the manual's Operation (shadow stacks disabled:
# CET is a v1 TODO): the return address is pushed at the operand size and
# EIP/IP truncated. Far calls aren't in v1.
@operation
IF near relative call
    THEN tempRIP := RIP + SignExtend(DEST);
    ELSE tempRIP := DEST;
FI;
IF OperandSize = 16 THEN tempRIP := tempRIP AND FFFFH; FI;
IF OperandSize = 32 THEN tempRIP := tempRIP AND FFFFFFFFH; FI;
Push(RIP);
RIP := tempRIP;
