# RDMSR—Read From Model Specific Register -- override (Operation and opcodes:
# the page's opcode table has no Instruction column, SDM errata E-14)
# 'EDX:EAX := MSR[ECX];' with the MSRs v1 has (Intel SDM Vol. 4, "Model-
# Specific Registers"; AMD64 APM Vol. 2 appendix A for the AMD ones);
# any other ECX, or CPL > 0, raises #GP(0) (the page's Protected Mode
# Exceptions). MTRRs (Vol. 3A 12.11), MCA (Vol. 3B 17.3), AMD OSVW and the
# core performance counters (APM Vol. 2 13.2; the legacy C001_0000-0007
# alias the first four).
@operation
IF CPL > 0 THEN #GP(0); FI;
IF ECX = 0C0000080H THEN tmp := EFER;
ELSE IF ECX = 0C0000100H THEN tmp := FS_BASE;
ELSE IF ECX = 0C0000101H THEN tmp := GS_BASE;
ELSE IF ECX = 0C0000102H THEN tmp := KERNEL_GS_BASE;
ELSE IF ECX = 0C0000081H THEN tmp := STAR;
ELSE IF ECX = 0C0000082H THEN tmp := LSTAR;
ELSE IF ECX = 0C0000083H THEN tmp := CSTAR;
ELSE IF ECX = 0C0000084H THEN tmp := FMASK;
ELSE IF ECX = 0C0000103H THEN tmp := TSC_AUX;
ELSE IF ECX = 10H THEN tmp := TSC;
ELSE IF ECX = 3BH THEN tmp := TSC_ADJUST;
ELSE IF ECX = 1BH THEN tmp := APIC_BASE;
ELSE IF ECX = 277H THEN tmp := PAT;
ELSE IF ECX = 1A0H THEN tmp := MISC_ENABLE;
ELSE IF ECX = 174H THEN tmp := SYSENTER_CS;
ELSE IF ECX = 175H THEN tmp := SYSENTER_ESP;
ELSE IF ECX = 176H THEN tmp := SYSENTER_EIP;
ELSE IF ECX = 2FFH THEN tmp := MTRR_DEF_TYPE;
ELSE IF ECX = 250H THEN tmp := MTRR_FIX64K_00000;
ELSE IF ECX = 258H THEN tmp := MTRR_FIX16K_80000;
ELSE IF ECX = 259H THEN tmp := MTRR_FIX16K_A0000;
ELSE IF ECX = 268H THEN tmp := MTRR_FIX4K_C0000;
ELSE IF ECX = 269H THEN tmp := MTRR_FIX4K_C8000;
ELSE IF ECX = 26AH THEN tmp := MTRR_FIX4K_D0000;
ELSE IF ECX = 26BH THEN tmp := MTRR_FIX4K_D8000;
ELSE IF ECX = 26CH THEN tmp := MTRR_FIX4K_E0000;
ELSE IF ECX = 26DH THEN tmp := MTRR_FIX4K_E8000;
ELSE IF ECX = 26EH THEN tmp := MTRR_FIX4K_F0000;
ELSE IF ECX = 26FH THEN tmp := MTRR_FIX4K_F8000;
ELSE IF ECX = 200H THEN tmp := MTRR_PHYSBASE0;
ELSE IF ECX = 201H THEN tmp := MTRR_PHYSMASK0;
ELSE IF ECX = 202H THEN tmp := MTRR_PHYSBASE1;
ELSE IF ECX = 203H THEN tmp := MTRR_PHYSMASK1;
ELSE IF ECX = 204H THEN tmp := MTRR_PHYSBASE2;
ELSE IF ECX = 205H THEN tmp := MTRR_PHYSMASK2;
ELSE IF ECX = 206H THEN tmp := MTRR_PHYSBASE3;
ELSE IF ECX = 207H THEN tmp := MTRR_PHYSMASK3;
ELSE IF ECX = 208H THEN tmp := MTRR_PHYSBASE4;
ELSE IF ECX = 209H THEN tmp := MTRR_PHYSMASK4;
ELSE IF ECX = 20AH THEN tmp := MTRR_PHYSBASE5;
ELSE IF ECX = 20BH THEN tmp := MTRR_PHYSMASK5;
ELSE IF ECX = 20CH THEN tmp := MTRR_PHYSBASE6;
ELSE IF ECX = 20DH THEN tmp := MTRR_PHYSMASK6;
ELSE IF ECX = 20EH THEN tmp := MTRR_PHYSBASE7;
ELSE IF ECX = 20FH THEN tmp := MTRR_PHYSMASK7;
ELSE IF ECX = 17AH THEN tmp := MCG_STATUS;
ELSE IF ECX = 17BH THEN tmp := MCG_CTL;
ELSE IF ECX = 400H THEN tmp := MC0_CTL;
ELSE IF ECX = 401H THEN tmp := MC0_STATUS;
ELSE IF ECX = 402H THEN tmp := MC0_ADDR;
ELSE IF ECX = 403H THEN tmp := MC0_MISC;
ELSE IF ECX = 0C0010140H THEN tmp := OSVW_ID_LENGTH;
ELSE IF ECX = 0C0010141H THEN tmp := OSVW_STATUS;
ELSE IF ECX = 0C0010200H THEN tmp := PERF_CTL0;
ELSE IF ECX = 0C0010201H THEN tmp := PERF_CTR0;
ELSE IF ECX = 0C0010202H THEN tmp := PERF_CTL1;
ELSE IF ECX = 0C0010203H THEN tmp := PERF_CTR1;
ELSE IF ECX = 0C0010204H THEN tmp := PERF_CTL2;
ELSE IF ECX = 0C0010205H THEN tmp := PERF_CTR2;
ELSE IF ECX = 0C0010206H THEN tmp := PERF_CTL3;
ELSE IF ECX = 0C0010207H THEN tmp := PERF_CTR3;
ELSE IF ECX = 0C0010208H THEN tmp := PERF_CTL4;
ELSE IF ECX = 0C0010209H THEN tmp := PERF_CTR4;
ELSE IF ECX = 0C001020AH THEN tmp := PERF_CTL5;
ELSE IF ECX = 0C001020BH THEN tmp := PERF_CTR5;
ELSE IF ECX = 0C0010000H THEN tmp := PERF_CTL0;
ELSE IF ECX = 0C0010001H THEN tmp := PERF_CTL1;
ELSE IF ECX = 0C0010002H THEN tmp := PERF_CTL2;
ELSE IF ECX = 0C0010003H THEN tmp := PERF_CTL3;
ELSE IF ECX = 0C0010004H THEN tmp := PERF_CTR0;
ELSE IF ECX = 0C0010005H THEN tmp := PERF_CTR1;
ELSE IF ECX = 0C0010006H THEN tmp := PERF_CTR2;
ELSE IF ECX = 0C0010007H THEN tmp := PERF_CTR3;
ELSE IF ECX = 0FEH THEN tmp := 508H;  (* MTRRCAP: VCNT 8, FIX, WC *)
ELSE IF ECX = 179H THEN tmp := 101H;  (* MCG_CAP: one bank, MCG_CTL present *)
ELSE IF (ECX >= 800H AND ECX <= 8FFH) OR ECX = 6E0H THEN
    (* x2APIC registers, IA32_TSC_DEADLINE: #GP if not legal *)
    tmp := ApicRead(ECX);
ELSE #GP(0);
FI;
EAX := tmp;
EDX := SHR(tmp, 32);
@opcodes
0F 32 | RDMSR | ZO | Valid | Valid
