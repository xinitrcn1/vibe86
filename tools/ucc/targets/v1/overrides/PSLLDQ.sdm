# PSLLDQ -- override: 'TEMP := COUNT; IF (TEMP > 15) THEN TEMP := 16; FI; DEST
# := DEST << (TEMP * 8)' -- a 128-bit shift, here byte by byte from the top
# (each byte reads the one TEMP below it before that one is written).
@operation
TEMP := imm8;
IF TEMP > 15 THEN TEMP := 16; FI;
FOR b := 15 DOWNTO 0
    IF b >= TEMP
        THEN DEST[8 * b + 7:8 * b] := DEST[8 * (b - TEMP) + 7:8 * (b - TEMP)];
        ELSE DEST[8 * b + 7:8 * b] := 0;
    FI;
ENDFOR
