# DELIVER -- vibe86 v1 exception and interrupt delivery
# The core enters here, with the working registers rolled back to the start
# of the interrupted instruction, for every exception, INT n/INT3 and
# external interrupt, with FAULT_VEC (bits 7:0 vector, 8 error code, 9
# software interrupt, 10 external), FAULT_ERR and FAULT_RIP set. It is INT
# n's Operation (Intel SDM Vol. 2A, "INT n/INTO/INT3/INT1") written for the
# three ways the processor can be running:
#   real-address mode: the IVT (REAL-ADDRESS-MODE branch);
#   protected mode: 8-byte interrupt/trap gates, a privilege change through
#     the 32-bit TSS (Vol. 3A 7.12.1 "Exception- or Interrupt-Handler
#     Procedures");
#   IA-32e mode: 16-byte gates, IST, a privilege change through the 64-bit
#     TSS, the stack aligned to 16 bytes (Vol. 3A 7.14 "Exception and
#     Interrupt Handling in 64-bit Mode").
# Problems with the IDT raise the manual's exceptions with the IDT error code
# (vector * 8 + 2, + 1 for an external event): an IDT too short or a gate of
# the wrong type #GP, a gate not present #NP, a software interrupt through a
# gate with DPL < CPL #GP; the core turns an exception raised while
# delivering into #DF or a shutdown as Vol. 3A 7.15 says (D-011). Protected
# mode task gates switch tasks (TaskSwitch). From virtual-8086 mode the
# handler must be a ring-0 non-conforming code segment (else #GP); the
# processor leaves virtual-8086 mode, switches to the TSS's ring-0 stack and
# pushes GS, FS, DS and ES before SS:ESP, then loads them with null
# selectors (INT n's INTER-PRIVILEGE-LEVEL-INTERRUPT branch from
# virtual-8086 mode; Vol. 3A 21.3.1.1, Figure 21-5).
@operation
vec := FAULT_VEC AND FFH;
soft := SHR(FAULT_VEC, 9) AND 1;
haserr := SHR(FAULT_VEC, 8) AND 1;
oldcpl := CPL;
oldflags := RFLAGS;
oldcs := CS;
oldss := SS;
oldrsp := RSP;
ecode := SHL(vec, 3) OR 2 OR (1 - soft);
IF CR0.PE = 0
    THEN
        IF IDTR_LIMIT < SHL(vec, 2) + 3 THEN SHUTDOWN; FI;
        ip := Linear16[IDTR_BASE + SHL(vec, 2)];
        cs := Linear16[IDTR_BASE + SHL(vec, 2) + 2];
        SP := SP - 2;
        Memory16[SS:SP] := oldflags;
        SP := SP - 2;
        Memory16[SS:SP] := oldcs;
        SP := SP - 2;
        Memory16[SS:SP] := FAULT_RIP;
        SetFlag(INTF, 0);
        SetFlag(TF, 0);
        SetFlag(AC, 0);
        SetSegmentReal(1, cs);
        RIP := ip;
    ELSE IF IA32_EFER.LMA = 1
    THEN
        IF IDTR_LIMIT < SHL(vec, 4) + 15 THEN #GP(ecode); FI;
        lo := Linear64[IDTR_BASE + SHL(vec, 4)];
        hi := Linear64[IDTR_BASE + SHL(vec, 4) + 8];
        IF (SHR(lo, 40) AND 1FH) != 0EH AND (SHR(lo, 40) AND 1FH) != 0FH THEN #GP(ecode); FI;
        IF soft = 1 AND (SHR(lo, 45) AND 3) < oldcpl THEN #GP(ecode); FI;
        IF (SHR(lo, 47) AND 1) = 0 THEN #NP(ecode); FI;
        target := (lo AND FFFFH) OR (SHR(lo, 32) AND FFFF0000H) OR SHL(hi, 32);
        sel := SHR(lo, 16) AND FFFFH;
        ist := SHR(lo, 32) AND 7;
        (* the handler's code segment (Vol. 3A 6.12.1.1, 6.14.1): a present
           code segment with DPL <= CPL, a 64-bit one in IA-32e mode; else
           #GP/#NP with the selector and EXT (a TSS selector in the gate
           was loaded as CS until tests/system/df-classes) *)
        IF (sel AND FFFCH) = 0 THEN #GP(1 - soft); FI;
        IF (sel OR 7) > GDTR_LIMIT THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        desc := Linear64[GDTR_BASE + (sel AND FFF8H)];
        IF (SHR(desc, 43) AND 3) != 3 THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        IF (SHR(desc, 45) AND 3) > oldcpl THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        IF (SHR(desc, 53) AND 3) != 1 THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        IF (SHR(desc, 47) AND 1) = 0 THEN #NP((sel AND FFFCH) OR (1 - soft)); FI;
        newcpl := SHR(desc, 45) AND 3;
        IF (SHR(desc, 42) AND 1) = 1 THEN newcpl := oldcpl; FI;
        WriteSpecial(CS_SEL, (sel AND FFFCH) OR newcpl);
        WriteSpecial(CS_BASE, 0);
        WriteSpecial(CS_LIMIT, FFFFFFFFH);
        WriteSpecial(CS_ATTR, DescAttr(desc));
        IF ist != 0 THEN
            RSP := Linear64[TR_BASE + 28 + SHL(ist, 3)];
        ELSE IF newcpl < oldcpl THEN
            RSP := Linear64[TR_BASE + 4 + SHL(newcpl, 3)];
        FI;
        IF newcpl < oldcpl THEN
            WriteSpecial(SS_SEL, newcpl);
            WriteSpecial(SS_BASE, 0);
        FI;
        WriteSpecial(CPL, newcpl);
        RSP := RSP AND FFFFFFFFFFFFFFF0H;
        RSP := RSP - 8;
        Memory64[SS:RSP] := oldss;
        RSP := RSP - 8;
        Memory64[SS:RSP] := oldrsp;
        RSP := RSP - 8;
        Memory64[SS:RSP] := oldflags;
        RSP := RSP - 8;
        Memory64[SS:RSP] := oldcs;
        RSP := RSP - 8;
        Memory64[SS:RSP] := FAULT_RIP;
        IF haserr = 1 THEN
            RSP := RSP - 8;
            Memory64[SS:RSP] := FAULT_ERR;
        FI;
        IF (SHR(lo, 40) AND 0FH) = 0EH THEN SetFlag(INTF, 0); FI;
        SetFlag(TF, 0);
        SetFlag(NT, 0);
        SetFlag(RF, 0);
        RIP := target;
    ELSE
        IF IDTR_LIMIT < SHL(vec, 3) + 7 THEN #GP(ecode); FI;
        g := Linear64[IDTR_BASE + SHL(vec, 3)];
        gty := SHR(g, 40) AND 1FH;
        IF gty != 05H AND gty != 06H AND gty != 07H AND gty != 0EH AND gty != 0FH THEN #GP(ecode); FI;
        IF soft = 1 AND (SHR(g, 45) AND 3) < oldcpl THEN #GP(ecode); FI;
        IF (SHR(g, 47) AND 1) = 0 THEN #NP(ecode); FI;
        IF gty = 05H
            THEN
                (* a task gate: switch tasks, then the error code on the new stack *)
                TaskSwitch(SHR(g, 16) AND FFFFH, 1, FAULT_RIP);
                IF haserr = 1 THEN PushW(FAULT_ERR, 4); FI;
            ELSE
        target := (g AND FFFFH) OR (SHR(g, 32) AND FFFF0000H);
        sel := SHR(g, 16) AND FFFFH;
        IF (sel AND FFFCH) = 0 THEN #GP(1 - soft); FI;
        IF (sel OR 7) > GDTR_LIMIT THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        desc := Linear64[GDTR_BASE + (sel AND FFF8H)];
        IF (SHR(desc, 43) AND 3) != 3 THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        IF (SHR(desc, 45) AND 3) > oldcpl THEN #GP((sel AND FFFCH) OR (1 - soft)); FI;
        IF (SHR(desc, 47) AND 1) = 0 THEN #NP((sel AND FFFCH) OR (1 - soft)); FI;
        newcpl := SHR(desc, 45) AND 3;
        IF (SHR(desc, 42) AND 1) = 1 THEN newcpl := oldcpl; FI;
        fromvm := SHR(oldflags, 17) AND 1;
        IF fromvm = 1 THEN
            IF newcpl != 0 OR (SHR(desc, 42) AND 1) = 1 THEN #GP(sel AND FFFCH); FI;
            oldgs := GS;
            oldfs := FS;
            oldds := DS;
            oldes := ES;
            SetFlag(VM, 0);
        FI;
        IF newcpl < oldcpl THEN
            newss := Linear16[TR_BASE + 8 + SHL(newcpl, 3)];
            newesp := Linear32[TR_BASE + 4 + SHL(newcpl, 3)];
            ssdesc := Linear64[GDTR_BASE + (newss AND FFF8H)];
            WriteSpecial(SS_SEL, newss);
            WriteSpecial(SS_BASE, DescBase(ssdesc));
            WriteSpecial(SS_LIMIT, DescLimit(ssdesc));
            WriteSpecial(SS_ATTR, DescAttr(ssdesc));
            ESP := newesp;
        FI;
        WriteSpecial(CS_SEL, (sel AND FFFCH) OR newcpl);
        WriteSpecial(CS_BASE, DescBase(desc));
        WriteSpecial(CS_LIMIT, DescLimit(desc));
        WriteSpecial(CS_ATTR, DescAttr(desc));
        WriteSpecial(CPL, newcpl);
        IF fromvm = 1 THEN
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldgs;
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldfs;
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldds;
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldes;
            SetSegment(3, 0, 0, 0, 0);
            SetSegment(0, 0, 0, 0, 0);
            SetSegment(4, 0, 0, 0, 0);
            SetSegment(5, 0, 0, 0, 0);
        FI;
        IF newcpl < oldcpl THEN
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldss;
            ESP := ESP - 4;
            Memory32[SS:ESP] := oldrsp;
        FI;
        ESP := ESP - 4;
        Memory32[SS:ESP] := oldflags;
        ESP := ESP - 4;
        Memory32[SS:ESP] := oldcs;
        ESP := ESP - 4;
        Memory32[SS:ESP] := FAULT_RIP;
        IF haserr = 1 THEN
            ESP := ESP - 4;
            Memory32[SS:ESP] := FAULT_ERR;
        FI;
        IF (SHR(g, 40) AND 7) = 6 THEN SetFlag(INTF, 0); FI;
        SetFlag(TF, 0);
        SetFlag(NT, 0);
        SetFlag(RF, 0);
        RIP := target;
        FI;
FI;
@flags
None.
