IN                  immz
OUT                 immz
PUSHF_PUSHFD_PUSHFQ only='PUSHFQ|^9C.*PUSHF$'  class=d64  osz=PUSHF:16,PUSHFQ:64
POPF_POPFD_POPFQ    only='POPFQ|^9D.*POPF$'    class=d64  osz=POPF:16,POPFQ:64
